---
import Base from "@/docs/src/layouts/Base.astro";
---

<Base title="Tag">
  <h1>Tag</h1>
  <p>Compound component for tag groups with optional dismiss. Uses <code>&lt;ul&gt;/&lt;li&gt;</code> for proper ARIA list semantics.</p>

  <h2>Sub-components</h2>
  <ul>
    <li><code>TagGroup</code> — root, provides <code>onRemove</code> context</li>
    <li><code>TagList</code> — container with optional label, renders <code>&lt;ul&gt;</code></li>
    <li><code>Tag</code> — individual tag chip, renders <code>&lt;li&gt;</code></li>
    <li><code>TagDismiss</code> — standalone dismiss button</li>
  </ul>

  <h2>Variants</h2>
  <div class="demo">
    <div class="demo-row">
      <code>default</code> — surface background, border
    </div>
    <div class="demo-row">
      <code>status</code> — status color tokens
    </div>
    <div class="demo-row">
      <code>priority</code> — priority color tokens
    </div>
  </div>

  <h2>Props</h2>
  <table class="props-table">
    <thead>
      <tr><th>Prop</th><th>Type</th><th>Default</th><th>Description</th></tr>
    </thead>
    <tbody>
      <tr><td><code>variant</code></td><td><code>"default" | "status" | "priority"</code></td><td><code>"default"</code></td><td>Visual variant</td></tr>
      <tr><td><code>removable</code></td><td><code>boolean</code></td><td><code>false</code></td><td>Show dismiss button</td></tr>
      <tr><td><code>onRemove</code></td><td><code>() => void</code></td><td>—</td><td>Dismiss callback</td></tr>
    </tbody>
  </table>

  <h2>Usage</h2>
  <pre><code>{`<TagGroup onRemove={(key) => removeTag(key)}>
  <TagList label="Tags">
    <Tag variant="default">design</Tag>
    <Tag variant="status">active</Tag>
    <Tag variant="priority" removable onRemove={() => {}}>
      urgent
    </Tag>
  </TagList>
</TagGroup>`}</code></pre>
</Base>
